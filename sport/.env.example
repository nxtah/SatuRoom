# Koneksi runtime: user bola_app (tanpa BYPASSRLS). Bukan koneksi migrator.
DATABASE_URL=postgresql://bola_app:bola-dev-only@localhost:5434/saturoom
# Alamat publik aplikasi ini (dipakai di link email).
APP_URL=http://localhost:3200
# Alamat website publik (link "kembali ke beranda").
SITE_URL=http://localhost:3100
# SMTP. Dev memakai Mailpit (lihat email di http://localhost:8026).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SatuRoom Bola <no-reply@saturoom.com>"
# true di production (HTTPS). false hanya untuk http://localhost.
COOKIE_SECURE=false

# Masuk dengan Google (opsional). Tombol Google baru muncul bila kedua nilai ini diisi.
# Redirect URI yang didaftarkan di Google Cloud: ${APP_URL}/api/v1/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
